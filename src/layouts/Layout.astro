---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Zwei Softwareentwickler reden ueber KI und AI." } = Astro.props;
const siteTitle = "Tinkerers Podcast";
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="alternate" type="application/rss+xml" title={siteTitle} href="/feed.xml" />
		<title>{fullTitle}</title>
	</head>
	<body class="bg-zinc-950 text-zinc-100 min-h-screen">
		<header class="border-b border-zinc-800">
			<nav class="max-w-3xl mx-auto px-4 py-6 flex items-center justify-between">
				<a href="/" class="text-xl font-bold tracking-tight hover:text-amber-400 transition-colors">
					Tinkerers
				</a>
				<a
					href="/feed.xml"
					class="text-sm text-zinc-400 hover:text-amber-400 transition-colors"
				>
					RSS Feed
				</a>
			</nav>
		</header>

		<main class="max-w-3xl mx-auto px-4 py-10">
			<slot />
		</main>

		<footer class="border-t border-zinc-800 mt-20">
			<div class="max-w-3xl mx-auto px-4 py-6 text-sm text-zinc-500">
				&copy; {new Date().getFullYear()} Tinkerers &mdash; Michael Heide &amp; Levin Keller
			</div>
		</footer>
	</body>
</html>
