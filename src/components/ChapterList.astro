---
interface Chapter {
	time: string;
	title: string;
	url?: string;
}

interface Props {
	chapters: Chapter[];
}

const { chapters } = Astro.props;
---

{chapters.length > 0 && (
	<div class="mt-8">
		<h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400 mb-4">Kapitel</h2>
		<ol class="space-y-1">
			{chapters.map((chapter) => (
				<li class="flex items-baseline gap-3 py-1.5 px-2 rounded hover:bg-zinc-900/50 transition-colors">
					<button
						class="chapter-btn font-mono text-xs text-amber-400 hover:text-amber-300 shrink-0 cursor-pointer bg-transparent border-none"
						data-time={chapter.time}
					>
						{chapter.time}
					</button>
					<span class="text-sm text-zinc-300">
						{chapter.url ? (
							<a href={chapter.url} target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors underline decoration-zinc-700">
								{chapter.title}
							</a>
						) : (
							chapter.title
						)}
					</span>
				</li>
			))}
		</ol>
	</div>
)}

<script>
	function timeToSeconds(time: string): number {
		const parts = time.split(":").map(Number);
		return parts[0] * 3600 + parts[1] * 60 + parts[2];
	}

	document.querySelectorAll<HTMLButtonElement>(".chapter-btn").forEach((btn) => {
		btn.addEventListener("click", () => {
			const audio = document.getElementById("audio-player") as HTMLAudioElement | null;
			const time = btn.dataset.time;
			if (audio && time) {
				audio.currentTime = timeToSeconds(time);
				audio.play();
			}
		});
	});
</script>
