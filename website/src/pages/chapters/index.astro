---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const chapters = (await getCollection("chapters")).sort((a, b) =>
	a.data.name.localeCompare(b.data.name, "de"),
);

const allEvents = await getCollection("events");
const now = Date.now();

const upcomingByChapter = new Map<string, number>();
for (const event of allEvents) {
	if (event.data.cancelled) continue;
	if (event.data.date.valueOf() < now) continue;
	const count = upcomingByChapter.get(event.data.chapter) ?? 0;
	upcomingByChapter.set(event.data.chapter, count + 1);
}
---

<Layout
	title="Chapters"
	description="Tinkerers-Chapter sind lokale Gruppen, die sich regelmäßig treffen, um gemeinsam mit KI etwas zu bauen."
>
	<section class="mb-12">
		<h1 class="text-3xl font-bold tracking-tight mb-3">Chapters</h1>
		<p class="text-base-content/70 max-w-2xl">
			Lokale Tinkerers-Gruppen, die sich regelmäßig treffen und gemeinsam an
			Ideen aus der Nachbarschaft arbeiten — vom ersten App-Account bis zum
			eigenen kleinen Tool. Jede:r ist willkommen, Pitches sind die Basis für
			die Themen der Treffen.
		</p>
	</section>

	<section class="space-y-4 mb-12">
		{chapters.map((chapter) => {
			const upcoming = upcomingByChapter.get(chapter.slug) ?? 0;
			return (
				<a href={`/chapters/${chapter.slug}/`} class="block group">
					<article class="card bg-base-200 border border-base-300 transition-all hover:border-primary/50 hover:scale-[1.005]">
						<div class="card-body p-6">
							<div class="flex items-baseline gap-3 mb-1 flex-wrap">
								<h2 class="card-title text-xl group-hover:text-primary transition-colors">
									{chapter.data.name}
								</h2>
								{upcoming > 0 && (
									<span class="badge badge-primary badge-sm">
										{upcoming} {upcoming === 1 ? "Termin" : "Termine"}
									</span>
								)}
							</div>
							<p class="text-sm text-base-content/60">
								{chapter.data.location}
								{chapter.data.region && <> &middot; {chapter.data.region}</>}
							</p>
						</div>
					</article>
				</a>
			);
		})}
	</section>

	<section class="card bg-base-200 border border-base-300">
		<div class="card-body p-6">
			<h2 class="card-title text-lg">Eigenes Chapter starten?</h2>
			<p class="text-sm text-base-content/70">
				Wenn ihr in eurem Ort eine Tinkerers-Runde aufbauen wollt, sprecht uns
				gerne an — wir helfen beim Format und legen das Chapter hier an.
			</p>
			<a
				href="https://github.com/tinkerers-de/community/discussions"
				class="btn btn-outline btn-sm w-fit mt-2"
				target="_blank"
				rel="noopener"
			>
				Community &rarr;
			</a>
		</div>
	</section>
</Layout>
