---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import EpisodeCard from "../../components/EpisodeCard.astro";

const episodes = (await getCollection("episodes")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Alle Episoden">
	<section class="mb-12">
		<h1 class="text-3xl font-bold tracking-tight mb-2">Episoden</h1>
		<p class="text-base-content/60">
			Alle Folgen von Tinkerers &mdash; Tinkern mit AI in der Softwareentwicklung.
		</p>
	</section>

	<section>
		<div class="space-y-4">
			{episodes.map((episode) => (
				<EpisodeCard
					number={episode.data.number}
					title={episode.data.title}
					slug={episode.id}
					date={episode.data.date}
					description={episode.data.description}
					duration={episode.data.duration}
				/>
			))}
		</div>
	</section>
</Layout>
