---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import AudioPlayer from "../../components/AudioPlayer.astro";
import ChapterList from "../../components/ChapterList.astro";

export async function getStaticPaths() {
	const episodes = await getCollection("episodes");
	return episodes.map((episode) => ({
		params: { slug: episode.id.replace(/\.mdx?$/, "") },
		props: { episode },
	}));
}

const { episode } = Astro.props;
const { Content } = await render(episode);
const { title, description, date, duration, audio, chapters, number, hosts } = episode.data;

const formattedDate = date.toLocaleDateString("de-DE", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
const episodeNumber = String(number).padStart(3, "0");
const siteUrl = (Astro.site?.toString() ?? "https://tinkerers.de").replace(/\/$/, "");
const slug = episode.id.replace(/\.mdx?$/, "");
const episodeUrl = `${siteUrl}/podcast/${slug}`;

// Convert "HH:MM:SS" to ISO 8601 duration "PT1H6M20S"
const [h, m, s] = duration.split(":").map(Number);
const isoDuration = `PT${h ? `${h}H` : ""}${m}M${s}S`;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "PodcastEpisode",
	name: title,
	description,
	datePublished: date.toISOString().split("T")[0],
	duration: isoDuration,
	url: episodeUrl,
	episodeNumber: number,
	associatedMedia: {
		"@type": "MediaObject",
		contentUrl: audio.mp3.url,
		encodingFormat: "audio/mpeg",
	},
	partOfSeries: {
		"@type": "PodcastSeries",
		name: "Tinkerers Podcast",
		url: siteUrl,
	},
	author: hosts.map((name) => ({ "@type": "Person", name })),
};
---

<Layout title={title} description={description} og={{ type: "article" }} jsonLd={jsonLd}>
	<article>
		<header class="mb-8">
			<div class="flex items-baseline gap-3 mb-2">
				<span class="badge badge-primary badge-sm font-mono">#{episodeNumber}</span>
				<time class="text-xs text-base-content/40" datetime={date.toISOString()}>
					{formattedDate}
				</time>
				<span class="text-xs text-base-content/30">{duration}</span>
			</div>
			<h1 class="text-3xl font-bold tracking-tight mb-2">{title}</h1>
			<p class="text-base-content/60">{description}</p>
			<p class="text-xs text-base-content/30 mt-2">Mit {hosts.join(" & ")}</p>
		</header>

		<AudioPlayer mp3={audio.mp3.url} m4a={audio.m4a.url} opus={audio.opus.url} />

		<ChapterList chapters={chapters} />

		<div class="mt-10 prose prose-headings:text-base-content prose-a:text-primary max-w-none">
			<Content />
		</div>
	</article>

	<nav class="mt-16">
		<a href="/podcast/" class="btn btn-ghost btn-sm gap-1">
			&larr; Alle Episoden
		</a>
	</nav>
</Layout>
