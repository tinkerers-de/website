---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PodcastLinks from "../components/PodcastLinks.astro";

const episodes = (await getCollection("episodes")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const episodeCount = episodes.length;

const chapters = await getCollection("chapters");
const chapterCount = chapters.length;

const now = Date.now();
const upcomingEventCount = (await getCollection("events")).filter(
	(event) => !event.data.cancelled && event.data.date.valueOf() >= now,
).length;
---

<Layout title="Tinkerers">
	<!-- Hero -->
	<section class="py-16 sm:py-24 text-center">
		<h1 class="text-5xl sm:text-7xl font-bold tracking-tighter mb-4">
			Tinkerers
		</h1>
		<p class="text-lg sm:text-xl text-base-content/60 max-w-xl mx-auto mb-4">
			Wir bauen Dinge mit AI &mdash; und reden drüber.
		</p>
		<p class="text-sm text-base-content/40 max-w-lg mx-auto">
			Michael Heide und Levin Keller sind zwei Softwareentwickler, die mit
			KI-Tools experimentieren, Prototypen basteln und herausfinden wollen,
			was wirklich funktioniert. Kein Hype, sondern Hands-on.
		</p>
	</section>

	<!-- Projekte -->
	<section class="pb-16">
		<h2 class="text-sm font-semibold uppercase tracking-wider text-base-content/40 mb-6">
			Projekte
		</h2>

		<!-- Podcast -->
		<div class="card bg-base-200 border border-base-300 mb-4">
			<a href="/podcast/" class="card-body flex-row items-center gap-6 hover:opacity-80 transition-opacity">
				<img
					src="/cover-512.jpg"
					alt="Tinkerers Cover"
					width="96"
					height="96"
					class="rounded-xl shrink-0"
					transition:name="podcast-cover"
				/>
				<div>
					<h3 class="card-title text-xl">Tinkerers — Der Podcast</h3>
					<p class="text-base-content/60">
						Tinkern mit AI in der Softwareentwicklung.
						{episodeCount} {episodeCount === 1 ? "Episode" : "Episoden"} bisher.
					</p>
				</div>
			</a>
			<div class="card-body pt-0">
				<PodcastLinks />
			</div>
		</div>

		<!-- Chapters -->
		<a href="/chapters/" class="block group">
			<div class="card bg-base-200 border border-base-300 transition-all hover:border-primary/50 hover:scale-[1.005]">
				<div class="card-body p-6">
					<h3 class="card-title text-xl group-hover:text-primary transition-colors">
						Chapters — Treffen vor Ort
					</h3>
					<p class="text-base-content/60">
						Lokale Tinkerers-Gruppen, die regelmäßig zusammenkommen und
						gemeinsam mit KI an konkreten Ideen aus der Nachbarschaft bauen.
						{chapterCount} {chapterCount === 1 ? "Chapter" : "Chapters"}
						{upcomingEventCount > 0 && (
							<>, {upcomingEventCount} kommende{upcomingEventCount === 1 ? "r" : ""} {upcomingEventCount === 1 ? "Termin" : "Termine"}</>
						)}.
					</p>
				</div>
			</div>
		</a>
	</section>

	<!-- Mitmachen -->
	<section class="pb-16">
		<h2 class="text-sm font-semibold uppercase tracking-wider text-base-content/40 mb-6">
			Mitmachen
		</h2>
		<a
			href="https://github.com/tinkerers-de/community/discussions"
			class="btn btn-outline btn-sm"
			target="_blank"
			rel="noopener"
		>
			Community &rarr;
		</a>
	</section>
</Layout>
