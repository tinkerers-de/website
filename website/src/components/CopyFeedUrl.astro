---
interface Props {
	url: string;
}

const { url } = Astro.props;
---

<span data-copy-feed={url}>
	<slot />
</span>

<script>
	document.querySelectorAll<HTMLElement>("[data-copy-feed]").forEach((el) => {
		el.style.cursor = "pointer";
		el.addEventListener("click", async () => {
			const url = el.dataset.copyFeed!;
			try {
				await navigator.clipboard.writeText(url);
			} catch {
				window.open(url, "_blank");
				return;
			}

			const toast = document.createElement("div");
			toast.className = "toast toast-top toast-center z-[100]";
			toast.innerHTML = `<div class="alert alert-success"><span>Feed-URL kopiert!</span></div>`;
			document.body.appendChild(toast);
			setTimeout(() => toast.remove(), 2000);
		});
	});
</script>
