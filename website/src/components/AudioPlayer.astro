---
interface Props {
	mp3: string;
	m4a: string;
	opus: string;
}

const { mp3, m4a, opus } = Astro.props;
---

<div class="rounded-lg bg-base-200 border border-base-300 p-4">
	<audio id="audio-player" controls preload="metadata" class="w-full">
		<source src={opus} type="audio/ogg; codecs=opus" />
		<source src={m4a} type="audio/mp4" />
		<source src={mp3} type="audio/mpeg" />
		Dein Browser unterstützt kein Audio-Element.
	</audio>
</div>
