---
import CopyFeedUrl from "./CopyFeedUrl.astro";
---

<nav class="flex items-baseline justify-between px-4 py-3 bg-base-100/80 backdrop-blur-lg border-b border-base-300 sticky top-0 z-50">
	<a href="/" class="text-xl font-bold tracking-tight hover:text-primary transition-colors">
		Tinkerers
	</a>
	<div class="flex items-baseline gap-4 text-sm">
		<a href="/podcast/" class="hover:text-primary transition-colors">Podcast</a>
		<a href="https://github.com/tinkerers-de/community/discussions" class="hover:text-primary transition-colors" target="_blank" rel="noopener">
			Community
		</a>
		<CopyFeedUrl url="https://tinkerers.de/podcast/feed.xml">
			<button type="button" class="hover:text-primary transition-colors cursor-pointer" title="Feed-URL kopieren">
				RSS
			</button>
		</CopyFeedUrl>
	</div>
</nav>
