---
import CopyFeedUrl from "./CopyFeedUrl.astro";
---

<div class="navbar bg-base-100 border-b border-base-300 sticky top-0 z-50">
	<div class="navbar-start">
		<a href="/" class="btn btn-ghost text-xl font-bold tracking-tight hover:text-primary">
			Tinkerers
		</a>
	</div>
	<div class="navbar-end gap-1">
		<a href="/podcast/" class="btn btn-ghost btn-sm">Podcast</a>
		<a href="https://github.com/tinkerers-de/community/discussions" class="btn btn-ghost btn-sm" target="_blank" rel="noopener">
			Community
		</a>
		<CopyFeedUrl url="https://tinkerers.de/podcast/feed.xml">
			<button type="button" class="btn btn-ghost btn-sm" title="Feed-URL kopieren">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
					<path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z" />
				</svg>
				<span class="hidden sm:inline">RSS</span>
			</button>
		</CopyFeedUrl>
	</div>
</div>
