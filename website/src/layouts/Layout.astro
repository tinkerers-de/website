---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Zwei Softwareentwickler reden übers Tinkern mit AI." } = Astro.props;
const siteTitle = "Tinkerers Podcast";
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="alternate" type="application/rss+xml" title={siteTitle} href="/podcast/feed.xml" />
		<title>{fullTitle}</title>
	</head>
	<body class="bg-base-100 text-base-content min-h-screen flex flex-col">
		<Navbar />

		<main class="flex-1 w-full max-w-3xl mx-auto px-4 py-10">
			<slot />
		</main>

		<Footer />
	</body>
</html>
